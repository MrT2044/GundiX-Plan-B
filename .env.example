# GundiX runtime environment. Copy to .env and fill in.
# NEVER put a private key in this file or anywhere in the repo.

# Operating mode: RESEARCH | OBSERVE | PAPER | SHADOW | LIVE
# Missing/invalid value => RESEARCH (never LIVE).
GUNDIX_MODE=PAPER

# Path to the runtime config yaml.
GUNDIX_CONFIG=config/runtime.example.yaml

# Solana RPC (HTTP) used for gap recovery / transaction fetch.
GUNDIX_RPC_HTTP_URL=

# Chain event source (websocket / provider endpoint).
GUNDIX_WS_URL=
GUNDIX_PROVIDER_API_KEY=

# LIVE only. Must be set explicitly and separately; ignored in every other mode.
# The signer keypair path lives OUTSIDE this repository.
GUNDIX_LIVE_CONFIG=
GUNDIX_LIVE_SIGNER_KEYPAIR_PATH=
GUNDIX_LIVE_EXPECTED_WALLET=
