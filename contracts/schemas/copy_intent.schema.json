{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gundix.local/schemas/copy_intent.schema.json",
  "title": "CopyIntent",
  "description": "S0 4.5. Produced by Plan B, read by Plan A for evaluation. Invariant: one source_event_id produces at most one intent with decision = EXECUTE. NO_TRADE entries are logged in full, because Plan A derives the real signal frequency and the rejection reasons from them.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "intent_id": { "$ref": "common.schema.json#/$defs/sha256_hex" },
    "source_event_id": { "$ref": "common.schema.json#/$defs/sha256_hex" },
    "source_wallet": { "$ref": "common.schema.json#/$defs/solana_address" },
    "created_at_utc": { "$ref": "common.schema.json#/$defs/utc_millis" },
    "base_mint": { "$ref": "common.schema.json#/$defs/solana_address" },
    "quote_mint": { "$ref": "common.schema.json#/$defs/solana_address" },
    "side": { "$ref": "common.schema.json#/$defs/side" },
    "target_size_quote_raw": {
      "$ref": "common.schema.json#/$defs/raw_amount",
      "description": "BUY: quote raw amount to spend. SELL: the quote value the sold fraction is expected to realise, informational. \"0\" for NO_TRADE."
    },
    "target_fraction_bps": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 10000,
      "description": "SELL only: the fraction of the copy holding to sell, in basis points, mirroring the fraction the source wallet sold of its own reconstructed holding."
    },
    "target_base_raw": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/raw_amount" }, { "type": "null" }],
      "description": "SELL only: the resolved base amount target_fraction_bps corresponds to at decision time. Never larger than the recorded copy position."
    },
    "max_slippage_bps": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "expires_at_utc": { "$ref": "common.schema.json#/$defs/utc_millis" },
    "mode": { "$ref": "common.schema.json#/$defs/operating_mode" },
    "decision": { "type": "string", "enum": ["EXECUTE", "NO_TRADE"] },
    "reason_code": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "wallet_not_selected",
            "selection_invalid",
            "selection_expired",
            "duplicate_event",
            "event_too_old",
            "event_not_final",
            "decode_incomplete",
            "unknown_venue",
            "transfer_not_swap",
            "unsupported_token",
            "no_route",
            "quote_stale",
            "slippage_too_high",
            "liquidity_too_low",
            "position_limit",
            "daily_limit",
            "insufficient_balance",
            "kill_switch_active",
            "state_mismatch",
            "no_copy_position_to_sell",
            "mode_disallows_execution",
            "transaction_failed",
            "dedup_policy_suppressed",
            "size_below_minimum"
          ]
        },
        { "type": "null" }
      ],
      "description": "Mandatory for NO_TRADE, null for EXECUTE. The last three values extend Plan B section 5 with strictly narrower reasons and are listed in CCR-002."
    },
    "reason_detail": { "type": ["string", "null"] },
    "selection_id": { "type": "string", "minLength": 1 },
    "policy_version": { "$ref": "common.schema.json#/$defs/semver" },
    "dedup_policy": {
      "type": "string",
      "enum": ["FIRST_SIGNAL_ONLY", "CONSENSUS_REQUIRED", "INCREMENT_WITH_CAP"]
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "source_event_id",
    "source_wallet",
    "created_at_utc",
    "base_mint",
    "quote_mint",
    "side",
    "target_size_quote_raw",
    "target_fraction_bps",
    "target_base_raw",
    "max_slippage_bps",
    "expires_at_utc",
    "mode",
    "decision",
    "reason_code",
    "selection_id",
    "policy_version",
    "dedup_policy"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "EXECUTE" } }, "required": ["decision"] },
      "then": { "properties": { "reason_code": { "type": "null" } } }
    },
    {
      "if": { "properties": { "decision": { "const": "NO_TRADE" } }, "required": ["decision"] },
      "then": { "properties": { "reason_code": { "type": "string" } } }
    }
  ]
}
